---
import { Image } from "astro:assets";
import logoImage from "../../assets/logo.png";
---

<footer class="border-t-2 border-gold bg-primary pt-12 pb-6 text-secondary">
  <div class="section-container">
    <div
      class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-3 lg:grid-cols-4 items-start"
    >
      <!-- Col 1: Logo + Brand -->
      <div
        class="col-span-2 md:col-span-1 flex justify-center md:justify-start"
      >
        <a
          href="/"
          class="flex flex-col items-center md:items-start gap-3 mb-4"
        >
          <Image
            src={logoImage}
            alt="Resuelve Tu Herencia"
            class="h-16 md:h-24 w-auto"
            width={256}
            height={256}
          />
        </a>
      </div>

      <!-- Col 2: Links -->
      <div>
        <h4
          class="mb-4 font-sans text-sm font-bold text-white underline underline-offset-4"
        >
          Enlaces
        </h4>
        <ul class="space-y-2 text-sm text-secondary/75">
          <li>
            <a
              href="/#servicios"
              class="hover:text-gold transition-colors duration-200"
              >Servicios</a
            >
          </li>
          <li>
            <a
              href="/#herramientas"
              class="hover:text-gold transition-colors duration-200"
              >Herramientas</a
            >
          </li>
          <li>
            <a
              href="/#sobre-nosotros"
              class="hover:text-gold transition-colors duration-200"
              >Sobre Nosotros</a
            >
          </li>
          <li>
            <a
              href="/#faq"
              class="hover:text-gold transition-colors duration-200"
              >Preguntas Frecuentes</a
            >
          </li>
          <li>
            <a
              href="/contacto"
              class="hover:text-gold transition-colors duration-200">Contacto</a
            >
          </li>
        </ul>
      </div>

      <!-- Col 3: Oficina -->
      <div class="text-right md:text-left">
        <h4
          class="mb-4 font-sans text-sm font-bold text-white underline underline-offset-4"
        >
          Oficina
        </h4>
        <ul class="space-y-2 text-sm text-secondary/75">
          <li>28752, Lozoyuela</li>
          <li>Madrid, Madrid</li>
        </ul>
      </div>

      <!-- Col 4: Contacto -->
      <div class="col-span-2 md:col-span-1 text-center md:text-left">
        <h4
          class="mb-4 font-sans text-sm font-bold text-white underline underline-offset-4"
        >
          Contacto
        </h4>
        <ul class="space-y-2 text-sm text-secondary/75">
          <li>
            <a
              href="tel:+34613955069"
              class="hover:text-gold transition-colors duration-200"
            >
              +34 613 95 50 69
            </a>
          </li>
          <li>
            <a
              href="mailto:agnresuelvetuherencia@gmail.com"
              class="hover:text-gold transition-colors duration-200"
            >
              agnresuelvetuherencia@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright line -->
    <div class="mt-10 border-t border-gold/20 pt-6 text-center">
      <p class="text-xs text-gold/70">
        Copyright &copy; {new Date().getFullYear()} Resuelve tu Herencia. Todos los
        derechos reservados.
      </p>
      <div
        class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-gold/70"
      >
        <a
          href="/aviso-legal"
          class="hover:text-gold transition-colors duration-200">Aviso Legal</a
        >
        <a
          href="/politica-privacidad"
          class="hover:text-gold transition-colors duration-200"
          >Política de Privacidad</a
        >
        <a
          href="/cookies"
          class="hover:text-gold transition-colors duration-200"
          >Política de Cookies</a
        >
      </div>
    </div>
  </div>
</footer>
