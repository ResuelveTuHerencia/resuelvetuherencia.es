---

<div class="whatsapp-btn-container fixed bottom-6 right-6 z-[999] flex items-center gap-3 select-none pointer-events-none md:bottom-8 md:right-8">
  <!-- Tooltip / Greeting bubble -->
  <div 
    id="whatsapp-tooltip" 
    class="whatsapp-tooltip opacity-0 translate-x-4 transition-all duration-500 ease-out bg-white text-primary text-xs font-semibold px-4 py-2.5 rounded-xl shadow-lg border border-slate-100/80 flex items-center gap-2 whitespace-nowrap font-sans"
  >
    <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
    ¿Tienes alguna duda? ¡Escríbenos!
  </div>

  <!-- The interactive float button -->
  <a
    href="https://wa.me/34608065589?text=Hola,%20me%20gustaría%20solicitar%20información%20sobre%20la%20gestión%20de%20una%20herencia."
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-float-btn pointer-events-auto relative flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#20ba5a] text-white rounded-full shadow-2xl transition-all duration-300 active:scale-95 group focus:outline-none focus:ring-4 focus:ring-emerald-300"
    aria-label="Contactar por WhatsApp"
  >
    <!-- Pulse ripple effects -->
    <span class="absolute inset-0 rounded-full bg-[#25D366]/40 animate-whatsapp-pulse pointer-events-none"></span>
    <span class="absolute inset-0 rounded-full bg-[#25D366]/20 animate-whatsapp-pulse-delayed pointer-events-none"></span>

    <!-- Icon SVG (Official FontAwesome WhatsApp SVG path) -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="w-7 h-7 fill-current drop-shadow-sm z-10 relative">
      <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L3 496l133-34.9c32.7 17.8 69.4 27.2 107.8 27.2 122.4 0 222-99.6 222-222 0-59.3-23-115.1-64.9-157.1zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-79.8 20.9 21.3-77.8-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 54 81.2 54 130.5 0 101.7-82.8 184.5-184.6 184.5zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
    </svg>
  </a>
</div>

<script>
  const initWhatsApp = () => {
    const tooltip = document.getElementById("whatsapp-tooltip");
    const container = document.querySelector(".whatsapp-btn-container");
    const button = document.querySelector(".whatsapp-float-btn");
    
    if (!tooltip || !button) return;

    // Show button entrance
    setTimeout(() => {
      container?.classList.add("visible");
    }, 1200);

    // Auto-show tooltip after 3.5 seconds
    let autoShowTimeout = setTimeout(() => {
      tooltip.classList.remove("opacity-0", "translate-x-4");
      tooltip.classList.add("opacity-100", "translate-x-0");
    }, 3500);

    // Auto-hide tooltip after 9.5 seconds (shows for 6 seconds)
    let autoHideTimeout = setTimeout(() => {
      tooltip.classList.add("opacity-0", "translate-x-4");
      tooltip.classList.remove("opacity-100", "translate-x-0");
    }, 9500);

    // Hover interactions
    button.addEventListener("mouseenter", () => {
      clearTimeout(autoShowTimeout);
      clearTimeout(autoHideTimeout);
      tooltip.classList.remove("opacity-0", "translate-x-4");
      tooltip.classList.add("opacity-100", "translate-x-0");
    });

    button.addEventListener("mouseleave", () => {
      tooltip.classList.add("opacity-0", "translate-x-4");
      tooltip.classList.remove("opacity-100", "translate-x-0");
    });
  };

  // Run on initial load and view transitions
  document.addEventListener("DOMContentLoaded", initWhatsApp);
  document.addEventListener("astro:page-load", initWhatsApp);
</script>

<style>
  .whatsapp-btn-container {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .whatsapp-btn-container.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes whatsappPulse {
    0% {
      transform: scale(1);
      opacity: 0.75;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .animate-whatsapp-pulse {
    animation: whatsappPulse 2.4s infinite cubic-bezier(0.25, 0, 0, 1);
  }

  .animate-whatsapp-pulse-delayed {
    animation: whatsappPulse 2.4s infinite cubic-bezier(0.25, 0, 0, 1);
    animation-delay: 1.2s;
  }

  /* Subtle periodic wiggle to grab attention in a professional way */
  @keyframes whatsappWiggle {
    0%, 88%, 100% {
      transform: rotate(0deg) scale(1);
    }
    90% {
      transform: rotate(-10deg) scale(1.08);
    }
    92% {
      transform: rotate(12deg) scale(1.08);
    }
    94% {
      transform: rotate(-8deg) scale(1.08);
    }
    96% {
      transform: rotate(6deg) scale(1.08);
    }
    98% {
      transform: rotate(-3deg) scale(1.08);
    }
  }

  .whatsapp-float-btn {
    animation: whatsappWiggle 14s infinite ease-in-out;
  }

  .whatsapp-float-btn:hover {
    animation-play-state: paused;
    transform: scale(1.12);
    box-shadow: 0 25px 50px -12px rgba(37, 211, 102, 0.4);
  }
  
  .whatsapp-float-btn:active {
    transform: scale(0.95);
  }
</style>
