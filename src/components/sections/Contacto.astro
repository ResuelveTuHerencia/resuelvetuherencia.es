---
---
<section id="contacto" class="bg-white py-20 lg:py-24">
  <div class="section-container max-w-4xl">
    <div class="rounded-2xl border border-gold/20 bg-secondary p-4 sm:p-8 md:p-12 shadow-lg">
      <div id="contact-wrapper">
        <div class="mb-10 text-center">
          <h2 class="mb-4 font-serif text-3xl sm:text-4xl font-bold text-primary">Solicita tu Sesión Diagnóstica</h2>
          <p class="text-primary/65 text-sm sm:text-base max-w-lg mx-auto">Déjanos tus datos y nos pondremos en contacto contigo para evaluar tu caso sin compromiso.</p>
        </div>

        <form action="/api/submit" method="POST" class="grid gap-5 md:grid-cols-2" id="secure-contact-form">
        
        <!-- Honeypot anti-spam para interceptar envíos de bots automatizados -->
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="md:col-span-1">
          <label for="name" class="mb-1.5 block text-sm font-medium text-primary">Nombre y Apellidos</label>
          <input type="text" id="name" name="name" required 
            pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s'\-]{2,60}$"
            maxlength="60"
            title="Solo letras y espacios (entre 2 y 60 caracteres)"
            class="w-full rounded-lg border border-primary/15 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors duration-200" 
            placeholder="Ej. Juan Pérez" />
        </div>

        <div class="md:col-span-1">
          <label for="phone" class="mb-1.5 block text-sm font-medium text-primary">Teléfono</label>
          <input type="tel" id="phone" name="phone" required 
            pattern="^[+]?[0-9\s.\-()]{9,15}$"
            maxlength="15"
            title="Formato de teléfono no válido (ej. 600 000 000)"
            class="w-full rounded-lg border border-primary/15 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors duration-200" 
            placeholder="Ej. 600 000 000" />
        </div>

        <div class="md:col-span-1">
          <label for="email" class="mb-1.5 block text-sm font-medium text-primary">Correo Electrónico</label>
          <input type="email" id="email" name="email" required 
            maxlength="100"
            class="w-full rounded-lg border border-primary/15 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors duration-200" 
            placeholder="tucorreo@ejemplo.com" />
        </div>

        <div class="md:col-span-1">
          <label for="municipio" class="mb-1.5 block text-sm font-medium text-primary">Municipio de Madrid</label>
          <input type="text" id="municipio" name="municipio" required 
            pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s'\-.,]{2,50}$"
            maxlength="50"
            title="Solo letras, números y espacios (entre 2 y 50 caracteres)"
            class="w-full rounded-lg border border-primary/15 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors duration-200" 
            placeholder="Ej. Alcobendas, Madrid Centro..." />
        </div>

        <div class="md:col-span-2">
          <label for="message" class="mb-1.5 block text-sm font-medium text-primary">Tipo de Consulta (Breve)</label>
          <textarea id="message" name="message" rows="3" required 
            maxlength="500"
            class="w-full rounded-lg border border-primary/15 bg-white px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors duration-200 resize-none" 
            placeholder="¿En qué podemos ayudarte?"></textarea>
        </div>

        <div class="md:col-span-2 text-center mt-2">
          <button type="submit" class="btn-primary w-full md:w-auto cursor-pointer">
            ENVIAR SOLICITUD
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const setupForm = () => {
    const form = document.getElementById('secure-contact-form') as HTMLFormElement | null;
    const wrapper = document.getElementById('contact-wrapper');

    if (form && wrapper) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const inputs = form.querySelectorAll('input[type="text"], input[type="tel"], textarea');
        let isSafe = true;

        inputs.forEach((input) => {
          const value = (input as HTMLInputElement | HTMLTextAreaElement).value;
          if (/[<>&=]/.test(value)) {
            isSafe = false;
          }
        });

        if (!isSafe) {
          alert('Se han detectado caracteres especiales no permitidos en tu mensaje (<, >, &, =). Por favor, evítalos.');
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalBtnText = submitBtn ? submitBtn.innerText : 'ENVIAR SOLICITUD';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'ENVIANDO...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch('/api/submit', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (response.ok && result.success) {
            wrapper.innerHTML = `
              <div class="text-center py-12 px-4 animate-fade-in-up flex flex-col items-center max-w-lg mx-auto">
                <div class="w-16 h-16 bg-gold/10 text-gold rounded-full flex items-center justify-center mb-6 border border-gold/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-8 h-8">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="font-serif text-2xl sm:text-3xl font-bold text-primary mb-4">¡Solicitud Enviada!</h2>
                <p class="text-primary/70 text-sm sm:text-base leading-relaxed mb-6 font-sans">
                  Gracias por contactar con nosotros. Un especialista revisará tu caso y te llamará en las próximas 24 horas hábiles.
                </p>
                <a href="/" class="btn-outline text-xs px-6 py-2.5">
                  VOLVER A INICIO
                </a>
              </div>
            `;
          } else {
            alert(result.message || 'Hubo un error al enviar la solicitud. Por favor, inténtalo de nuevo.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerText = originalBtnText;
            }
          }
        } catch (err) {
          console.error('Error submitting form:', err);
          alert('Error de conexión. Por favor, verifica tu conexión a internet e inténtalo de nuevo.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;
          }
        }
      });
    }
  };

  document.addEventListener('astro:page-load', setupForm);
</script>
