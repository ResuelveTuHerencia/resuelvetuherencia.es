---

---

<section id="inicio" class="relative bg-secondary overflow-hidden">
  <!-- Premium background aesthetic elements -->
  <div
    class="absolute top-0 right-0 -translate-y-24 translate-x-24 w-[600px] h-[600px] bg-gold/5 rounded-full filter blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 translate-y-24 -translate-x-24 w-[400px] h-[400px] bg-primary/5 rounded-full filter blur-[80px] pointer-events-none"
  >
  </div>

  <div
    class="section-container py-16 lg:py-24 relative z-10 flex flex-col items-center text-center"
  >
    <!-- Main Content Block -->
    <div class="max-w-4xl animate-fade-in-up flex flex-col items-center">
      <!-- Location / Expertise Tag -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gold/10 border border-gold/20 text-gold text-xs sm:text-sm font-semibold tracking-wide uppercase mb-6"
      >
        <span class="flex h-2 w-2 rounded-full bg-gold animate-pulse"></span>
        Asesoría de Herencias en la Sierra de Madrid
      </div>

      <h1
        class="mb-6 font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.15] text-primary max-w-3xl"
      >
        Tramitación de herencias <span class="text-gold">en Madrid</span>
      </h1>

      <p
        class="mb-8 text-lg sm:text-xl text-primary/80 leading-relaxed max-w-2xl"
      >
        Expertos en gestión de sucesiones y patrimonio familiar en la Comunidad
        de Madrid. Liquidamos tu Impuesto de Sucesiones y Plusvalía Municipal
        minimizando la carga tributaria. Resolvemos todo el trámite llave en
        mano sin desplazamientos al centro, con atención digital y presencial en
        Lozoyuela, Alcobendas, Colmenar Viejo y toda la Sierra Norte.
      </p>

      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 mb-10 w-full sm:w-auto"
      >
        <a
          href="/contacto"
          class="btn-primary text-center px-8 py-4 shadow-lg shadow-gold/15 hover:shadow-gold/25 text-xs sm:text-sm"
        >
          SOLICITAR SESIÓN GRATUITA
        </a>
        <a
          href="/#servicios"
          class="btn-outline text-center px-8 py-3 text-xs sm:text-sm"
        >
          VER NUESTROS SERVICIOS
        </a>
      </div>

      <!-- Trust Elements -->
      <div
        class="flex flex-wrap justify-center items-center gap-x-6 gap-y-4 border-t border-primary/10 pt-6 w-full max-w-2xl"
      >
        <div class="flex items-center gap-2">
          <div class="flex text-gold">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"
              ><path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path></svg
            >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"
