---

---

<section
  id="servicios"
  class="bg-primary py-20 lg:py-24 relative overflow-hidden"
>
  <!-- Decorative background glow elements for premium AXO visual appeal -->
  <div
    class="absolute -left-1/4 -top-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute -right-1/4 -bottom-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div class="section-container relative z-10">
    <!-- Header: Optimized for Local SEO, SEM, GEO, AEO, and AXO -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2
        class="mb-4 text-center font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight"
      >
        Tramitación Integral de Herencias
      </h2>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        Ofrecemos un servicio de <strong
          >gestión y tramitación integral de herencias en Madrid</strong
        >, ocupándonos de todo el proceso sucesorio de principio a fin, desde la
        recopilación inicial de documentos hasta la inscripción definitiva de
        los bienes en el Registro de la Propiedad. Acompañamos a los herederos
        durante todas las fases de la herencia, evitando gestiones innecesarias,
        errores administrativos y problemas fiscales.
      </p>
    </div>

    <!-- Grid of Services / Phases: AEO & GEO structured grid layout -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Fase 1: Recopilación y Análisis de Documentación -->
      <div
        class="card-service flex flex-col items-start gap-4 p-5 sm:p-6 md:p-8 border border-white/5 hover:border-gold/30 hover:shadow-gold/5 transition-all duration-300"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-lg bg-gold/10 text-gold mb-2 shrink-0"
        >
          <!-- Document Search Icon -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-7 h-7"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <circle cx="11.5" cy="14.5" r="2.5"></circle>
            <line x1="16" y1="19" x2="13.25" y2="16.25"></line>
          </svg>
        </div>
        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-primary">
            1. Recopilación y Revisión Documental
          </h3>
          <p class="text-sm text-primary/75 leading-relaxed">
            Nos encargamos de la gestión completa de la herencia, comenzando por
            la <strong
              >recopilación y revisión de toda la documentación necesaria</strong
            >, tanto personal como patrimonial. Analizamos cada caso de forma
            individual para determinar los pasos a seguir y planificar
            correctamente el proceso desde el punto de vista jurídico y fiscal.
          </p>
        </div>
      </div>

      <!-- Fase 2: Coordinación Notarial y Testamento -->
      <div
        class="card-service flex flex-col items-start gap-4 p-5 sm:p-6 md:p-8 border border-white/5 hover:border-gold/30 hover:shadow-gold/5 transition-all duration-300"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-lg bg-gold/10 text-gold mb-2 shrink-0"
        >
          <!-- Notary / Users Icon -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-7 h-7"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
            ></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="9" y1="15" x2="15" y2="15"></line>
            <line x1="9" y1="19" x2="13" y2="19"></line>
            <line x1="9" y1="11" x2="11" y2="11"></line>
          </svg>
        </div>
        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-primary">
            2. Coordinación Notarial y Sucesión
          </h3>
          <p class="text-sm text-primary/75 leading-relaxed">
            Realizamos la <strong>coordinación directa con la notaría</strong>,
            gestionando la declaración de herederos abintestato en los casos en
            que no existe testamento, así como la localización y obtención de la
            copia autorizada del testamento cuando sí lo hay. Acompañamos a los
            herederos en todo el proceso notarial y resolvemos las dudas que
            puedan surgir, facilitando una tramitación clara y ordenada.
          </p>
        </div>
      </div>

      <!-- Fase 3: Adjudicación y Partición de Herencia -->
      <div
        class="card-service flex flex-col items-start gap-4 p-5 sm:p-6 md:p-8 border border-white/5 hover:border-gold/30 hover:shadow-gold/5 transition-all duration-300"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-lg bg-gold/10 text-gold mb-2 shrink-0"
        >
          <!-- Split / Agreement Icon -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-7 h-7"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-primary">
            3. Adjudicación y Partición de Bienes
          </h3>
          <p class="text-sm text-primary/75 leading-relaxed">
            Preparamos y gestionamos la <strong
              >adjudicación y partición de la herencia</strong
            >, asegurando que el reparto de los bienes se realice conforme a la
            legalidad y de la forma más adecuada para los herederos. Elaboramos
            el cuaderno particional con el objetivo de evitar conflictos futuros
            y dejar la herencia correctamente cerrada desde el punto de vista
            jurídico.
          </p>
        </div>
      </div>

      <!-- Fase 4: Liquidación Fiscal de Impuestos (Optimización CCAA) -->
      <div
        class="card-service flex flex-col items-start gap-4 p-5 sm:p-6 md:p-8 border border-white/5 hover:border-gold/30 hover:shadow-gold/5 transition-all duration-300"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-lg bg-gold/10 text-gold mb-2 shrink-0"
        >
          <!-- Scales / Tax / Protection Icon -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-7 h-7"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="9" x2="15" y2="15"></line>
            <circle cx="9" cy="15" r="1"></circle>
            <circle cx="15" cy="9" r="1"></circle>
          </svg>
        </div>
        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-primary">
            4. Liquidación Fiscal de Sucesiones
          </h3>
          <p class="text-sm text-primary/75 leading-relaxed">
            En materia fiscal, nos ocupamos de la <strong
              >liquidación del Impuesto sobre Sucesiones y Donaciones</strong
            >, así como de la <strong>plusvalía municipal</strong> cuando proceda.
            Aplicamos la normativa vigente teniendo en cuenta las particularidades
            de la Comunidad de Madrid y de cada Comunidad Autónoma, controlando estrictamente
            los plazos legales para evitar recargos, sanciones o intereses de demora.
          </p>
        </div>
      </div>

      <!-- Fase 5: Inscripción Registral y Regularización -->
      <div
        class="card-service flex flex-col items-start gap-4 p-5 sm:p-6 md:p-8 border border-white/5 hover:border-gold/30 hover:shadow-gold/5 transition-all duration-300"
      >
        <div
          class="w-12 h-12 flex items-center justify-center rounded-lg bg-gold/10 text-gold mb-2 shrink-0"
        >
          <!-- House Register Icon -->
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="w-7 h-7"
            aria-hidden="true"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-primary">
            5. Registro de la Propiedad
          </h3>
          <p class="text-sm text-primary/75 leading-relaxed">
            Una vez finalizados los trámites notariales y fiscales, gestionamos
            la <strong
              >inscripción de los bienes heredados en el Registro de la
              Propiedad</strong
            >, garantizando que los inmuebles queden correctamente inscritos a
            nombre de los herederos y que la herencia quede plenamente
            regularizada de forma oficial y definitiva.
          </p>
        </div>
      </div>

      <!-- Tarjeta 6 (CTA): Compromiso y Asesoramiento Gratuito -->
      <div
        class="flex flex-col justify-between rounded-xl border-2 border-gold bg-primary/45 backdrop-blur-md p-5 sm:p-6 md:p-8 shadow-lg transition-all duration-300 hover:shadow-gold/10 hover:-translate-y-1 text-white relative overflow-hidden group"
      >
        <!-- Accent Glow -->
        <div
          class="absolute -right-20 -bottom-20 w-48 h-48 bg-gold/10 rounded-full blur-2xl group-hover:bg-gold/20 transition-colors duration-300"
        >
        </div>

        <div>
          <h3 class="mb-2.5 font-serif text-xl font-bold text-gold">
            ¿Por qué elegir nuestra gestión?
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed mb-6">
            Nuestro servicio de gestión integral de herencias se basa en un <strong
              >trato cercano, un lenguaje claro y una atención personalizada</strong
            >. Acompañamos a los herederos durante todo el proceso sucesorio,
            ofreciendo tranquilidad y seguridad en un momento especialmente
            delicado, y asegurando una tramitación completa y definitiva.
          </p>
        </div>

        <div class="mt-4">
          <a
            href="/contacto"
            class="btn-primary w-full text-center text-xs py-3.5 px-4 flex items-center justify-center gap-2 group-hover:scale-[1.02] transition-transform"
          >
            <span>Solicitar Sesión Diagnóstica</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              class="w-4 h-4"
              aria-hidden="true"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- JSON-LD Service Structured Data for advanced SEO/GEO positioning -->
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Tramitación Integral de Herencias",
    "serviceType": "Gestión Legal y Fiscal de Sucesiones",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Resuelve Tu Herencia",
      "url": "https://resuelvetuherencia.es",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Madrid",
        "addressRegion": "Comunidad de Madrid",
        "addressCountry": "ES"
      }
    },
    "areaServed": [
      {
        "@type": "AdministrativeArea",
        "name": "Comunidad de Madrid"
      },
      {
        "@type": "Country",
        "name": "España"
      }
    ],
    "description": "Servicio integral de tramitación de herencias en Madrid. Cubre la obtención de documentos, coordinación de testamentos ante notaría, adjudicación, liquidación de impuestos de sucesiones y plusvalía, e inscripción registral.",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Fases de la Tramitación de Herencias",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Recopilación y Revisión de Documentos",
            "description": "Gestión y análisis de documentación personal y patrimonial necesaria para la herencia."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Coordinación Notarial y Testamento",
            "description": "Obtención de testamentos, declaración de herederos abintestato y firma de la escritura de adjudicación."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Adjudicación y Partición de Herencia",
            "description": "Elaboración del cuaderno particional conforme a la legalidad para evitar conflictos familiares."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Liquidación del Impuesto de Sucesiones",
            "description": "Presentación y optimización fiscal de los impuestos de sucesiones y plusvalía municipal."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Inscripción en el Registro de la Propiedad",
            "description": "Registro oficial de los bienes raíces heredados a nombre de los nuevos propietarios."
          }
        }
      ]
    }
  }
</script>
