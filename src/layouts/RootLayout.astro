---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://resuelvetuherencia.es');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    
    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Resuelve Tu Herencia" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Local SEO -->
    <meta name="geo.region" content="ES-M" />
    <meta name="geo.placename" content="Madrid" />
    <meta name="robots" content="index, follow" />

    <!-- Google Fonts: Playfair Display (serif headings) + Inter (sans body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- JSON-LD Structured Data for Local Business -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Resuelve Tu Herencia",
      "description": "Asesoría integral especializada en tramitación de herencias, sucesiones y gestión patrimonial en Madrid.",
      "url": "https://resuelvetuherencia.es",
      "email": "agnresuelvetuherencia@gmail.com",
      "telephone": "+34613955069",
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 40.4168,
          "longitude": -3.7038
        },
        "geoRadius": "50000"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Madrid",
        "addressRegion": "Comunidad de Madrid",
        "addressCountry": "ES"
      },
      "priceRange": "€€"
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuál es el plazo para liquidar el Impuesto de Sucesiones en la Comunidad de Madrid?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El plazo legal para liquidar el Impuesto de Sucesiones y Donaciones en la Comunidad de Madrid es de 6 meses contados a partir del día del fallecimiento del causante. Se puede solicitar una prórroga por otros 6 meses adicionales, siempre y cuando se presente la solicitud formal de prórroga dentro de los primeros 5 meses del plazo general ante la Agencia Tributaria de Madrid."
          }
        },
        {
          "@type": "Question",
          "name": "¿Es necesario desplazarse a Madrid centro si resido en la Sierra Norte o municipios del norte?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, en absoluto. Ofrecemos una gestión de herencias 100% digitalizada o, si lo prefieres, nos reunimos contigo de forma presencial en Lozoyuela, Alcobendas, San Sebastián de los Reyes o Colmenar Viejo. Nos encargamos de coordinar con notarías locales y del norte de Madrid para la firma de la escritura de adjudicación, evitando desplazamientos innecesarios y ahorrando tiempo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué trámites legales se deben realizar si el fallecido no dejó testamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cuando no existe testamento, se debe tramitar una 'Declaración de Herederos Abintestato' ante notario para designar a los herederos legales (hijos, cónyuge o padres) según el Código Civil. Posteriormente, realizamos la recopilación de bienes, la redacción del cuaderno particional, la liquidación fiscal del Impuesto de Sucesiones en Madrid y el cambio de nombre en el Registro de la Propiedad."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo se calculan los honorarios para la tramitación de una herencia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ofrecemos una primera sesión diagnóstica 100% gratuita para evaluar tu caso (número de herederos, bienes inmuebles, cuentas, etc.). Tras este análisis inicial, te facilitamos un presupuesto cerrado y transparente llave en mano, garantizando que no habrá sorpresas, sobrecostes de gestión ni honorarios inesperados al final del proceso."
          }
        }
      ]
    }
    </script>

    <!-- View Transitions for smooth page animations -->
    <ClientRouter />

    <!-- Reset scroll position instantly after each page swap to prevent
         the "already scrolled" visual glitch caused by smooth scroll + ClientRouter -->
    <script>
      // Disable smooth scroll when navigation starts
      document.addEventListener('astro:before-preparation', () => {
        document.documentElement.style.scrollBehavior = 'auto';
      });

      document.addEventListener('astro:after-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto';
        // Scroll to top instantly if there is no hash in the destination URL
        if (!window.location.hash) {
          window.scrollTo(0, 0);
        }
      });

      // Once the page is loaded and any scroll-to-hash has finished, re-enable smooth scroll
      document.addEventListener('astro:page-load', () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.style.scrollBehavior = '';
          });
        });
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-secondary text-primary font-sans antialiased">
    <slot />
    <WhatsAppButton />
  </body>
</html>
