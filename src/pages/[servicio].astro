---
import RootLayout from "../layouts/RootLayout.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";
import { servicios, getServicio } from "../data/servicios";
import { SITE_URL } from "../data/site";

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { servicio: s.slug } }));
}

const { servicio: slug } = Astro.params;
const servicio = getServicio(slug!);
if (!servicio) throw new Error(`Servicio no encontrado: ${slug}`);

const url = `${SITE_URL}/${servicio.slug}`;
const otros = servicios.filter((s) => s.slug !== servicio.slug);

const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${url}#service`,
      "name": servicio.h1,
      "description": servicio.description,
      "url": url,
      "serviceType": "Gestión Legal y Fiscal de Sucesiones",
      "provider": { "@id": `${SITE_URL}/#organization` },
      "areaServed": { "@type": "AdministrativeArea", "name": "Comunidad de Madrid" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": servicio.h1, "item": url }
      ]
    }
  ]
};
---

<RootLayout title={servicio.title} description={servicio.description} faqItems={servicio.faqs}>
  <Navbar />
  <main class="bg-secondary">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />

    <article class="section-container py-16 lg:py-20 max-w-3xl">
      <nav aria-label="Ruta de navegación" class="mb-8 text-xs text-primary/60">
        <a href="/" class="hover:text-gold">Inicio</a>
        <span aria-hidden="true"> / </span>
        <span class="text-primary/80">{servicio.h1}</span>
      </nav>

      <h1 class="mb-6 font-serif text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-primary">
        {servicio.h1}
      </h1>
      <p class="mb-12 text-base sm:text-lg leading-relaxed text-primary/80">{servicio.intro}</p>

      {servicio.sections.map((section) => (
        <section class="mb-10">
          <h2 class="mb-3 font-serif text-2xl font-bold text-primary">{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p class="mb-4 text-sm sm:text-base leading-relaxed text-primary/75">{p}</p>
          ))}
          {section.items && (
            <ul class="list-disc pl-5 space-y-2 text-sm sm:text-base text-primary/75">
              {section.items.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}

      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-bold text-primary">Preguntas frecuentes</h2>
        <div class="space-y-4">
          {servicio.faqs.map((faq) => (
            <details class="group rounded-xl border border-gold/20 bg-white p-4 sm:p-5 shadow-sm open:border-gold/60">
              <summary class="cursor-pointer text-primary font-semibold text-base select-none">
                {faq.question}
              </summary>
              <p class="mt-3 text-sm sm:text-base leading-relaxed text-primary/70">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="rounded-2xl border-2 border-gold bg-white p-6 sm:p-8 text-center shadow-md">
        <p class="mb-5 font-serif text-xl font-bold text-primary">Sesión diagnóstica gratuita</p>
        <a href="/contacto" class="btn-primary inline-block px-8 py-4 text-xs sm:text-sm">
          SOLICITAR SESIÓN GRATUITA
        </a>
      </div>

      <nav aria-label="Otros servicios" class="mt-12">
        <h2 class="mb-4 font-serif text-xl font-bold text-primary">Otros servicios</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {otros.map((o) => (
            <li>
              <a href={`/${o.slug}`} class="block rounded-lg border border-primary/10 bg-white p-4 text-sm font-semibold text-primary hover:border-gold/50">
                {o.h1}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </article>
  </main>
  <Footer />
</RootLayout>
