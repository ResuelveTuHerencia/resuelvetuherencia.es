---
import RootLayout from "../layouts/RootLayout.astro";
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/Footer.astro";

---

<RootLayout
  title="Contacto | Resuelve Tu Herencia · Asesoría de Herencias en Madrid"
  description="Contacta con nosotros. Solicita tu sesión diagnóstica gratuita o visítanos en nuestra oficina en Lozoyuela, Sierra Norte de Madrid."
>
  <Navbar />

  <main class="bg-secondary py-16 lg:py-24 relative overflow-hidden">
    <!-- Background glows -->
    <div
      class="absolute -left-1/4 -top-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-[100px] pointer-events-none"
    >
    </div>
    <div
      class="absolute -right-1/4 -bottom-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-[100px] pointer-events-none"
    >
    </div>

    <div class="section-container relative z-10 max-w-6xl">
      <!-- Page Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h1
          class="mb-4 font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight"
        >
          Contacta con Nosotros
        </h1>
        <p class="text-base sm:text-lg text-primary/70 leading-relaxed">
          Solicita tu <strong>consulta 100% gratuita</strong> sin compromiso, visítanos
          en nuestra oficina central o envíanos tu consulta.
        </p>
      </div>

      <!-- Main Layout Grid -->
      <div class="grid gap-8 lg:grid-cols-12 items-start">
        <!-- Left: Secure Contact Form (col-span-7) -->
        <div
          class="lg:col-span-7 bg-white rounded-2xl border border-primary/10 p-5 sm:p-8 md:p-10 shadow-md animate-fade-in-up"
        >
          <div id="contact-page-wrapper">
            <h2 class="font-serif text-2xl font-bold text-primary mb-2">
              Formulario de Solicitud
            </h2>
            <p class="text-xs sm:text-sm text-primary/60 mb-6 font-sans">
              Completa el formulario y un especialista se pondrá en contacto
              contigo a la brevedad.
            </p>

            <form
              action="/api/submit"
              method="POST"
              class="grid gap-5 sm:grid-cols-2"
              id="secure-contact-page-form"
            >
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display: none;"
                tabindex="-1"
                autocomplete="off"
              />

            <div class="sm:col-span-1">
              <label
                for="name"
                class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-primary/80 font-sans"
                >Nombre y Apellidos</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s'\-]{2,60}$"
                maxlength="60"
                class="w-full rounded-lg border border-primary/15 bg-slate-50/50 px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all font-sans"
                placeholder="Ej. Juan Pérez"
              />
            </div>

            <div class="sm:col-span-1">
              <label
                for="phone"
                class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-primary/80 font-sans"
                >Teléfono</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                pattern="^[+]?[0-9\s.\-()]{9,15}$"
                maxlength="15"
                class="w-full rounded-lg border border-primary/15 bg-slate-50/50 px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all font-sans"
                placeholder="Ej. 600 000 000"
              />
            </div>

            <div class="sm:col-span-1">
              <label
                for="email"
                class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-primary/80 font-sans"
                >Correo Electrónico</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                maxlength="100"
                class="w-full rounded-lg border border-primary/15 bg-slate-50/50 px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all font-sans"
                placeholder="tucorreo@ejemplo.com"
              />
            </div>

            <div class="sm:col-span-1">
              <label
                for="municipio"
                class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-primary/80 font-sans"
                >Municipio de Residencia</label
              >
              <input
                type="text"
                id="municipio"
                name="municipio"
                required
                pattern="^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s'\-.,]{2,50}$"
                maxlength="50"
                class="w-full rounded-lg border border-primary/15 bg-slate-50/50 px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all font-sans"
                placeholder="Ej. Lozoyuela, Alcobendas..."
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="message"
                class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-primary/80 font-sans"
                >Tipo de Consulta (Breve)</label
              >
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                maxlength="500"
                class="w-full rounded-lg border border-primary/15 bg-slate-50/50 px-4 py-3 text-sm text-primary placeholder:text-primary/40 focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all resize-none font-sans"
                placeholder="Descríbenos brevemente tu caso (herederos, bienes inmuebles, testamento...)"
              ></textarea>
            </div>

            <div class="sm:col-span-2 mt-2">
              <button
                type="submit"
                class="btn-primary w-full cursor-pointer font-sans"
              >
                ENVIAR SOLICITUD DE ASESORAMIENTO
              </button>
            </div>
          </form>
          </div>
        </div>

        <!-- Right: Office Details & Map (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col gap-6 animate-fade-in-up">
          <!-- Office Details Card -->
          <div
            class="bg-white rounded-2xl border border-primary/10 p-5 sm:p-8 shadow-md"
          >
            <h2 class="font-serif text-2xl font-bold text-primary mb-6">
              Datos de la Oficina
            </h2>

            <div class="space-y-4">
              <div class="flex items-start gap-3.5">
                <div class="text-gold shrink-0 mt-0.5">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-5 h-5"
                    ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                    ></path><circle cx="12" cy="10" r="3"></circle></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-primary text-sm font-sans">
                    Dirección
                  </h4>
                  <p
                    class="text-xs sm:text-sm text-primary/70 leading-relaxed mt-0.5 font-sans"
                  >
                    Avenida de Madrid, 62, 28752 Lozoyuela, Madrid
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="text-gold shrink-0 mt-0.5">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-5 h-5"
                    ><circle cx="12" cy="12" r="10"></circle><polyline
                      points="12 6 12 12 16 14"></polyline></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-primary text-sm font-sans">
                    Horario
                  </h4>
                  <p
                    class="text-xs sm:text-sm text-primary/70 leading-relaxed mt-0.5 font-sans"
                  >
                    Lunes a Viernes: 09:00 - 18:00 (Cita previa recomendada)
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="text-gold shrink-0 mt-0.5">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-5 h-5"
                    ><path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                    ></path></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-primary text-sm font-sans">
                    Teléfono
                  </h4>
                  <a
                    href="tel:+34613955069"
                    class="text-xs sm:text-sm text-gold hover:underline mt-0.5 block font-sans"
                  >
                    +34 613 95 50 69
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3.5">
                <div class="text-gold shrink-0 mt-0.5">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-5 h-5"
                    ><path
                      d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                    ></path><polyline points="22,6 12,13 2,6"></polyline></svg
                  >
                </div>
                <div>
                  <h4 class="font-bold text-primary text-sm font-sans">
                    Correo Electrónico
                  </h4>
                  <a
                    href="mailto:agnresuelvetuherencia@gmail.com"
                    class="text-xs sm:text-sm text-gold hover:underline mt-0.5 block break-all font-sans"
                  >
                    agnresuelvetuherencia@gmail.com
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Interactive Map Container -->
          <div
            class="relative rounded-2xl border border-gold/30 overflow-hidden shadow-md bg-white h-[250px] sm:h-[320px] w-full"
          >
            <div
              id="contact-map-loader"
              class="absolute inset-0 bg-secondary/80 flex items-center justify-center z-20 transition-opacity duration-500"
            >
              <div class="flex flex-col items-center gap-3">
                <svg
                  class="animate-spin h-6 w-6 text-gold"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
                <span
                  class="text-[10px] text-primary/60 font-semibold tracking-wide font-sans"
                  >Cargando mapa...</span
                >
              </div>
            </div>
            <div id="contact-map" class="h-full w-full"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</RootLayout>

<script>
  import MapLibreGL from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  // Coordinates for Avenida de Madrid 62, Lozoyuela
  const longitude = -3.6176370164417504;
  const latitude = 40.92586430923798;

  let mapInstance: MapLibreGL.Map | null = null;

  // Initialize Map
  const initMap = () => {
    const mapContainer = document.getElementById("contact-map");
    const loader = document.getElementById("contact-map-loader");
    if (!mapContainer) return;

    if (mapInstance) {
      mapInstance.remove();
      mapInstance = null;
    }

    try {
      mapInstance = new MapLibreGL.Map({
        container: "contact-map",
        style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        center: [longitude, latitude],
        zoom: 15.5,
        scrollZoom: false,
        attributionControl: false,
      });

      mapInstance.addControl(
        new MapLibreGL.NavigationControl({ showCompass: false }),
        "top-right",
      );

      const el = document.createElement("div");
      el.className = "custom-marker";
      el.style.width = "36px";
      el.style.height = "36px";
      el.style.cursor = "pointer";
      el.style.display = "flex";
      el.style.alignItems = "center";
      el.style.justifyContent = "center";
      el.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" style="width:36px;height:36px;filter:drop-shadow(0 2px 6px rgba(0,0,0,0.35));" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#c5a059" stroke="#ffffff" stroke-width="1.5"/>
        </svg>
      `;

      const popup = new MapLibreGL.Popup({
        offset: 30,
        closeButton: false,
        className: "custom-map-popup",
        focusAfterOpen: false,
      }).setHTML(`
        <div class="p-3 font-sans text-primary">
          <p class="font-serif font-bold text-sm text-gold mb-1">Resuelve Tu Herencia</p>
          <p class="text-xs text-primary/80 leading-relaxed font-medium">Avenida de Madrid, 62, 28752 Lozoyuela, Madrid</p>
          <a href="https://www.google.com/maps/dir/?api=1&destination=40.92586430923798,-3.6176370164417504" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[10px] font-bold uppercase text-gold hover:underline mt-2">
            Cómo llegar
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-2.5 h-2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      `);

      new MapLibreGL.Marker({ element: el })
        .setLngLat([longitude, latitude])
        .setPopup(popup)
        .addTo(mapInstance);
      popup.setLngLat([longitude, latitude]).addTo(mapInstance);

      mapInstance.on("load", () => {
        if (loader) {
          loader.style.opacity = "0";
          setTimeout(() => loader.remove(), 500);
        }
      });
    } catch (err) {
      console.error(err);
      if (loader) loader.remove();
    }
  };

  // Run on Astro page transition change (which also runs on initial page load)
  document.addEventListener("astro:page-load", initMap);

  // Secure validation logic
  const setupFormValidation = () => {
    const form = document.getElementById(
      "secure-contact-page-form",
    ) as HTMLFormElement | null;
    const wrapper = document.getElementById("contact-page-wrapper");

    if (form && wrapper) {
      // Prefill message from tools redirection if present
      const storedMsg = sessionStorage.getItem("herramientas_msg");
      const messageField = document.getElementById("message") as HTMLTextAreaElement | null;
      if (storedMsg && messageField) {
        messageField.value = storedMsg;
        sessionStorage.removeItem("herramientas_msg");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const inputs = form.querySelectorAll(
          'input[type="text"], input[type="tel"], textarea',
        );
        let isSafe = true;
        inputs.forEach((input) => {
          const value = (input as HTMLInputElement | HTMLTextAreaElement).value;
          if (/[<>&=]/.test(value)) isSafe = false;
        });

        if (!isSafe) {
          alert(
            "Se han detectado caracteres especiales no permitidos en tu mensaje (<, >, &, =). Por favor, evítalos.",
          );
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalBtnText = submitBtn ? submitBtn.innerText : 'ENVIAR SOLICITUD DE ASESORAMIENTO';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'ENVIANDO...';
        }

        try {
          const formData = new FormData(form);
          const response = await fetch('/api/submit', {
            method: 'POST',
            body: formData
          });

          const result = await response.json();

          if (response.ok && result.success) {
            wrapper.innerHTML = `
              <div class="text-center py-12 px-4 animate-fade-in-up flex flex-col items-center max-w-lg mx-auto">
                <div class="w-16 h-16 bg-gold/10 text-gold rounded-full flex items-center justify-center mb-6 border border-gold/20">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-8 h-8">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <h2 class="font-serif text-2xl font-bold text-primary mb-4">¡Solicitud Recibida!</h2>
                <p class="text-primary/70 text-sm sm:text-base leading-relaxed mb-6 font-sans">
                  Hemos registrado tu consulta correctamente. Un especialista en herencias se pondrá en contacto contigo en un plazo máximo de 24 horas hábiles.
                </p>
                <a href="/" class="btn-outline text-xs px-6 py-2.5">
                  VOLVER A INICIO
                </a>
              </div>
            `;
          } else {
            alert(result.message || 'Hubo un error al enviar tu consulta. Por favor, inténtalo de nuevo.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerText = originalBtnText;
            }
          }
        } catch (err) {
          console.error(err);
          alert('Error de conexión. Por favor, comprueba tu red e inténtalo de nuevo.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = originalBtnText;
          }
        }
      });
    }
  };

  document.addEventListener("astro:page-load", setupFormValidation);
</script>

<style is:global>
  .custom-map-popup .maplibregl-popup-content {
    border-radius: 12px !important;
    border: 1px solid rgba(197, 160, 89, 0.3) !important;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
    background: #ffffff !important;
    padding: 0 !important;
  }
  .custom-map-popup .maplibregl-popup-anchor-top .maplibregl-popup-tip {
    border-bottom-color: rgba(197, 160, 89, 0.3) !important;
  }
  .custom-map-popup .maplibregl-popup-anchor-bottom .maplibregl-popup-tip {
    border-top-color: rgba(197, 160, 89, 0.3) !important;
  }
  .custom-map-popup .maplibregl-popup-anchor-left .maplibregl-popup-tip {
    border-right-color: rgba(197, 160, 89, 0.3) !important;
  }
  .custom-map-popup .maplibregl-popup-anchor-right .maplibregl-popup-tip {
    border-left-color: rgba(197, 160, 89, 0.3) !important;
  }
</style>
