---
import RootLayout from "../../layouts/RootLayout.astro";
import Navbar from "../../components/common/Navbar.astro";
import Footer from "../../components/common/Footer.astro";
import { servicios } from "../../data/servicios";
import { municipiosPublicados, getMunicipio, OFICINA } from "../../data/municipios";
import { SITE_URL } from "../../data/site";

// Solo se generan los municipios con publicado: true. Con todos en false no sale ninguna página.
export function getStaticPaths() {
  return municipiosPublicados.map((m) => ({ params: { municipio: m.slug } }));
}

const { municipio: slug } = Astro.params;
const m = getMunicipio(slug!);
if (!m) throw new Error(`Municipio no encontrado: ${slug}`);

const url = `${SITE_URL}/zona/${m.slug}`;
const title = m.esHub
  ? "Tramitación de herencias en Madrid capital | Resuelve Tu Herencia"
  : `Herencias en ${m.nombre} | Resuelve Tu Herencia`;
const description = m.esHub
  ? "Gestión de herencias, impuesto de sucesiones, plusvalía y herencias sin testamento en Madrid capital, con atención digital y presencial."
  : `Tramitación de herencias para familias de ${m.nombre}: sucesiones, plusvalía y herencia sin testamento, con atención digital y presencial en Lozoyuela.`;

const datosLocales = m.datoLocal.filter((d) => d.texto && d.fuente);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${url}#service`,
      "name": `Gestión de herencias en ${m.nombre}`,
      "description": description,
      "url": url,
      "serviceType": "Gestión Legal y Fiscal de Sucesiones",
      "provider": { "@id": `${SITE_URL}/#organization` },
      "areaServed": { "@type": m.esHub ? "City" : "AdministrativeArea", "name": m.nombre }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": `Herencias en ${m.nombre}`, "item": url }
      ]
    }
  ]
};
---

<RootLayout title={title} description={description} faqItems={m.faqs}>
  <Navbar />
  <main class="bg-secondary">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <article class="section-container py-16 lg:py-20 max-w-3xl">
      <nav aria-label="Ruta de navegación" class="mb-8 text-xs text-primary/60">
        <a href="/" class="hover:text-gold">Inicio</a>
        <span aria-hidden="true"> / </span>
        <span class="text-primary/80">Herencias en {m.nombre}</span>
      </nav>

      <h1 class="mb-6 font-serif text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight text-primary">
        Gestión de herencias en {m.nombre}
      </h1>
      <p class="mb-4 text-base sm:text-lg leading-relaxed text-primary/80">{m.intro}</p>
      {m.poblacion !== null && (
        <p class="mb-12 text-xs text-primary/50">
          Población aproximada: {m.poblacion.toLocaleString("es-ES")} habitantes. Fuente: {m.fuenteDato}.
        </p>
      )}

      <section class="mb-10">
        <h2 class="mb-4 font-serif text-2xl font-bold text-primary">Servicios para herencias en {m.nombre}</h2>
        <ul class="space-y-4">
          {m.bloques.map((b) => {
            const s = servicios.find((x) => x.slug === b.slug);
            return s && (
              <li class="rounded-lg border border-primary/10 bg-white p-4">
                <a href={`/${s.slug}`} class="font-serif text-lg font-bold text-primary hover:text-gold">{s.h1}</a>
                <p class="mt-2 text-sm sm:text-base leading-relaxed text-primary/75">{b.texto}</p>
              </li>
            );
          })}
        </ul>
      </section>

      {datosLocales.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-4 font-serif text-2xl font-bold text-primary">Datos prácticos de {m.nombre}</h2>
          <ul class="list-disc pl-5 space-y-2 text-sm sm:text-base text-primary/75">
            {datosLocales.map((d) => (
              <li>{d.texto} <span class="text-xs text-primary/50">(Fuente: {d.fuente})</span></li>
            ))}
          </ul>
        </section>
      )}

      <section class="mb-10">
        <h2 class="mb-3 font-serif text-2xl font-bold text-primary">Cómo trabajamos desde Lozoyuela</h2>
        <p class="mb-3 text-sm sm:text-base leading-relaxed text-primary/75">
          Nuestra oficina está en {OFICINA.direccion}. Atendemos por teléfono, videollamada y
          correo, y recibimos en persona en la oficina con cita previa.
        </p>
        <p class="text-sm sm:text-base leading-relaxed text-primary/75">
          No tenemos oficina abierta en {m.nombre}: la mayoría de los trámites se resuelven a distancia
          y, si hace falta reunirnos, lo hacemos en Lozoyuela.
        </p>
      </section>

      <section class="mb-12">
        <h2 class="mb-6 font-serif text-2xl font-bold text-primary">Preguntas frecuentes</h2>
        <div class="space-y-4">
          {m.faqs.map((faq) => (
            <details class="group rounded-xl border border-gold/20 bg-white p-4 sm:p-5 shadow-sm open:border-gold/60">
              <summary class="cursor-pointer text-primary font-semibold text-base select-none">{faq.question}</summary>
              <p class="mt-3 text-sm sm:text-base leading-relaxed text-primary/70">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="rounded-2xl border-2 border-gold bg-white p-6 sm:p-8 text-center shadow-md">
        <p class="mb-5 font-serif text-xl font-bold text-primary">Sesión diagnóstica gratuita</p>
        <a href="/contacto" class="btn-primary inline-block px-8 py-4 text-xs sm:text-sm">SOLICITAR SESIÓN GRATUITA</a>
      </div>
    </article>
  </main>
  <Footer />
</RootLayout>
